    public static void affichageNombre(int nombre){
        for (int i = 1; i <= nombre; i++) {
            System.out.println("Nombre: " + i);
        }
    }
    public static void tableMultiplication(int nombre){
        System.out.println("Table de multiplication de " + nombre + " :");
        for (int i = 1; i <= 10; i++) {
            System.out.println(nombre + " x " + i + " = " + (nombre * i));
        }
    }
    public static void intervalleCarre(int nombre){
        System.out.println("Carrés des nombres de 1 à " + nombre + " :");
        for (int i = 1; i <= nombre; i++) {
            System.out.println(i + " au carré = " + (i * i));
        }
